{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "white5-zoho-mail-mcp",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
