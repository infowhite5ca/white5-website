{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "white5-google-business-mcp",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "177ff5b5335d4b6d960040cfefb69cf6"
    }
  ],
  "durable_objects": { "bindings": [{ "name": "GBP_CONTROL", "class_name": "GBPControl" }] },
  "migrations": [{ "tag": "gbp-control-v1", "new_sqlite_classes": ["GBPControl"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "invocation_logs": false } }
}
