  {
    "name": "update_location",
    "description": "Preview validated business information changes. confirmed:true with validateOnly:true validates at Google without mutation; validateOnly:false applies after explicit approval.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "location": {
          "type": "string",
          "pattern": "^(?:locations\\/)?[0-9]+$"
