                    "type": "object",
                    "properties": {
                      "startDate": {
                        "type": "object",
                        "properties": {
                          "year": {
                            "type": "integer",
                            "minimum": 2000,
                            "maximum": 2100
                          },
                          "month": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 12
                          },
                          "day": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 31
                          }
                        },
                        "required": [
                          "year",
                          "month",
                          "day"
                        ],
                        "additionalProperties": false
                      },
                      "endDate": {
                        "type": "object",
                        "properties": {
                          "year": {
                            "type": "integer",
                            "minimum": 2000,
                            "maximum": 2100
                          },
