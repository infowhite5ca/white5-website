                          "minutes": {
                            "default": 0,
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 59
                          }
                        },
                        "additionalProperties": false
                      },
                      "closeDay": {
                        "type": "string",
                        "enum": [
                          "MONDAY",
                          "TUESDAY",
                          "WEDNESDAY",
                          "THURSDAY",
                          "FRIDAY",
                          "SATURDAY",
                          "SUNDAY"
                        ]
                      },
                      "closeTime": {
                        "type": "object",
                        "properties": {
                          "hours": {
                            "default": 0,
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 23
                          },
                          "minutes": {
                            "default": 0,
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 59
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "openDay",
                      "openTime",
                      "closeDay",
                      "closeTime"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "periods"
              ],
              "additionalProperties": false
            },
            "specialHours": {
              "type": "object",
              "properties": {
                "specialHourPeriods": {
                  "maxItems": 100,
