  {
    "name": "prepare_post",
    "description": "Validate and prepare a local STANDARD post draft with text, photo URLs and call-to-action/website links. No network calls or Google draft is created.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "account": {
          "type": "string",
          "pattern": "^(?:accounts\\/)?[0-9]+$"
        },
        "location": {
          "type": "string",
          "pattern": "^(?:locations\\/)?[0-9]+$"
        },
        "post": {
          "type": "object",
          "properties": {
            "languageCode": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1500
            },
            "callToAction": {
              "type": "object",
              "properties": {
                "actionType": {
                  "type": "string",
                  "enum": [
                    "BOOK",
                    "ORDER",
                    "SHOP",
                    "LEARN_MORE",
                    "SIGN_UP",
                    "CALL"
                  ]
                },
                "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "format": "uri"
                }
              },
              "required": [
                "actionType"
              ],
              "additionalProperties": false
            },
            "media": {
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "mediaFormat": {
                    "type": "string",
                    "const": "PHOTO"
                  },
                  "sourceUrl": {
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri"
                  }
                },
                "required": [
                  "sourceUrl"
                ],
                "additionalProperties": false
              }
            },
            "topicType": {
              "default": "STANDARD",
              "type": "string",
              "const": "STANDARD"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "account",
        "location",
        "post"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
