                "businessType": {
                  "type": "string",
                  "enum": [
                    "CUSTOMER_LOCATION_ONLY",
                    "CUSTOMER_AND_BUSINESS_LOCATION"
                  ]
                },
                "places": {
                  "type": "object",
                  "properties": {
                    "placeInfos": {
                      "minItems": 1,
                      "maxItems": 20,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "placeName": {
                            "type": "string",
                            "minLength": 1
                          },
                          "placeId": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]+$"
                          }
                        },
                        "required": [
                          "placeName",
                          "placeId"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "placeInfos"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "businessType",
                "places"
              ],
              "additionalProperties": false
            },
            "regularHours": {
              "type": "object",
