                  "maxLength": 40
                },
                "additionalPhones": {
                  "maxItems": 2,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 40
                  }
                }
              },
              "required": [
                "primaryPhone"
              ],
              "additionalProperties": false
            },
            "storefrontAddress": {
              "type": "object",
              "properties": {
                "regionCode": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                },
                "postalCode": {
                  "type": "string",
                  "maxLength": 30
                },
                "administrativeArea": {
                  "type": "string",
                  "maxLength": 100
                },
                "locality": {
                  "type": "string",
                  "maxLength": 100
                },
                "addressLines": {
                  "minItems": 1,
                  "maxItems": 5,
